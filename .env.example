# Copy this file to .env and fill in the values before running the app.
# .env is listed in .gitignore and must never be committed.

# ── Flask ────────────────────────────────────────────────────────────────────

# Secret key used by Flask to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-to-a-random-string

# ── OpenAI ───────────────────────────────────────────────────────────────────

# OpenAI API key used for follow-up chat responses.
# Obtain from https://platform.openai.com/api-keys
API_KEY=sk-...

# Model used for follow-up chat responses. Must be a real, accessible
# OpenAI model id (e.g. gpt-3.5-turbo, gpt-4o-mini). Defaults to
# gpt-3.5-turbo if unset. The app does not fall back automatically if
# this model is invalid or inaccessible — requests will simply fail.
OPENAI_MODEL=gpt-3.5-turbo

# max_completion_tokens budget for /chat follow-up completions. Reasoning
# models spend part of this budget on hidden reasoning tokens before any
# visible content is produced, so an empty reply is possible if this is
# set too low. Defaults to 512 if unset; not auto-adjusted on failure.
OPENAI_MAX_COMPLETION_TOKENS=512

# ── MongoDB ──────────────────────────────────────────────────────────────────
#
# db.py builds the connection URI by string-concatenating the four variables
# below in this order:
#
#   {MONGODB_UID}:{MONGODB_PWD}@{MONGODB_CLUSTER_NAME}{MONGODB_AUTH}
#
# which produces a full URI like:
#
#   mongodb://admin:password@localhost:27017/?authSource=admin
#
# MONGODB_UID carries both the URI scheme (mongodb://) and the username.
# MONGODB_CLUSTER_NAME is host:port only — do NOT add a leading "@".
# The "@" separator between password and host is inserted by the code.

# URI scheme + MongoDB username (the "mongodb://" prefix lives here).
MONGODB_UID=mongodb://admin

# MongoDB password for the user above.
MONGODB_PWD=password

# MongoDB host and port. For a local Docker instance this is always localhost:27017.
MONGODB_CLUSTER_NAME=localhost:27017

# Authentication source query string appended to the URI.
# "admin" is the default authSource for the MongoDB root user.
MONGODB_AUTH=/?authSource=admin

# ── Encryption (currently unused) ────────────────────────────────────────────
#
# Fernet symmetric key loaded by encryption_utils.py at import time.
# The module is not imported anywhere in the active code path, so this
# variable has no effect on the running app. It is included here so the
# module does not crash if it is ever re-enabled.
#
# Generate a valid key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
